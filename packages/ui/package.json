{
  "name": "@stackshop/ui",
  "version": "0.0.0",
  "private": true,
  "description": "StackShop shared UI kit (shadcn/ui + Tailwind v4 tokens)",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/globals.css",
    "./lib/utils": "./src/lib/utils.ts",
    "./components/*": "./src/components/*.tsx"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "radix-ui": "^1.8.1",
    "react-hook-form": "7.92.0",
    "tailwind-merge": "^3.0.0",
    "tw-animate-css": "^1.3.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@stackshop/config": "workspace:*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5"
  }
}
